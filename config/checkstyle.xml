<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Style checks for student submissions, following the CS102 Java Coding Style guide
    (https://smu.sg/cs102-coding-style). Every module carries an id; config/style-rules.properties
    maps each id to the guide section it enforces, its plain-language rule and its weight.
    Guide rules that Checkstyle cannot express are listed there as "not automatically checked".
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>
    <!-- A file that cannot be parsed is reported as "could not analyse" instead of stopping the run. -->
    <property name="haltOnException" value="false"/>

    <!-- Section 1. Line Length: maximum line length is 80 characters. -->
    <module name="LineLength">
        <property name="id" value="line-length"/>
        <property name="max" value="80"/>
        <message key="maxLineLen" value="Line is {1,number,integer} characters long; the limit is {0,number,integer}."/>
    </module>

    <!-- Section 5. Indentation: 4 spaces are used for indentation instead of tabs. -->
    <module name="FileTabCharacter">
        <property name="id" value="no-tabs"/>
        <property name="eachLine" value="true"/>
        <message key="containsTab" value="Line contains a tab; indent with spaces."/>
    </module>

    <module name="TreeWalker">
        <property name="tabWidth" value="4"/>

        <!-- Section 1. Line Length (a): break after a comma. -->
        <module name="SeparatorWrap">
            <property name="id" value="wrap-after-comma"/>
            <property name="tokens" value="COMMA"/>
            <property name="option" value="eol"/>
            <message key="line.previous" value="A wrapped line should not start with ''{0}''; break after the comma instead."/>
        </module>

        <!-- Section 1. Line Length (b): break before an operator. -->
        <module name="OperatorWrap">
            <property name="id" value="wrap-before-operator"/>
            <property name="option" value="nl"/>
            <message key="line.new" value="''{0}'' should start the next line; break before an operator, not after it."/>
        </module>

        <!-- Section 2. Simple Statements: at most one statement per line. -->
        <module name="OneStatementPerLine">
            <property name="id" value="one-statement-per-line"/>
            <message key="multiple.statements.line" value="More than one statement on this line."/>
        </module>

        <!-- Section 3. Variable Declaration: one declaration per line. -->
        <module name="MultipleVariableDeclarations">
            <property name="id" value="one-declaration-per-line"/>
            <message key="multiple.variable.declarations" value="Declare one variable per line."/>
            <message key="multiple.variable.declarations.comma" value="Declare one variable per statement."/>
        </module>

        <!-- Section 3. Variable Declaration: declare and initialise together; always initialise. -->
        <module name="grading.style.checks.InitializeAtDeclarationCheck">
            <property name="id" value="initialise-at-declaration"/>
        </module>

        <!-- Section 4. Meaningful variable names: lowerCamelCase, no one-character names
             (a one-character loop counter is allowed). -->
        <module name="LocalVariableName">
            <property name="id" value="variable-names"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
            <property name="allowOneCharVarInForLoop" value="true"/>
            <message key="name.invalidPattern"
                     value="Variable name ''{0}'' should be lowerCamelCase and longer than one character."/>
        </module>
        <module name="LocalFinalVariableName">
            <property name="id" value="variable-names"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
            <message key="name.invalidPattern"
                     value="Variable name ''{0}'' should be lowerCamelCase and longer than one character."/>
        </module>
        <module name="ParameterName">
            <property name="id" value="variable-names"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
            <message key="name.invalidPattern"
                     value="Parameter name ''{0}'' should be lowerCamelCase and longer than one character."/>
        </module>
        <module name="MemberName">
            <property name="id" value="variable-names"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
            <message key="name.invalidPattern"
                     value="Field name ''{0}'' should be lowerCamelCase and longer than one character."/>
        </module>
        <module name="StaticVariableName">
            <property name="id" value="variable-names"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]+$"/>
            <message key="name.invalidPattern"
                     value="Field name ''{0}'' should be lowerCamelCase and longer than one character."/>
        </module>
        <module name="MethodName">
            <property name="id" value="method-names"/>
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern" value="Method name ''{0}'' should be lowerCamelCase."/>
        </module>

        <!-- Section 4. Meaningful variable names: no magic numbers. -->
        <module name="MagicNumber">
            <property name="id" value="magic-numbers"/>
            <message key="magic.number" value="''{0}'' is a magic number; give it a named constant."/>
        </module>

        <!-- Section 5. Indentation: 4 spaces per level. -->
        <module name="Indentation">
            <property name="id" value="indentation"/>
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="arrayInitIndent" value="4"/>
            <property name="lineWrappingIndentation" value="8"/>
            <message key="indentation.error"
                     value="''{0}'' is indented {1} spaces; it should be indented {2}."/>
            <message key="indentation.child.error"
                     value="Code inside ''{0}'' is indented {1} spaces; it should be indented {2}."/>
        </module>

        <!-- Section 5. Indentation: curly braces MUST be used even for single statement blocks. -->
        <module name="NeedBraces">
            <property name="id" value="braces-always"/>
            <message key="needBraces" value="''{0}'' must use curly braces, even for a single statement."/>
        </module>

        <!-- Section 5. Indentation: K&R brace placement. -->
        <module name="LeftCurly">
            <property name="id" value="kr-braces"/>
            <message key="line.new" value="Put ''{0}'' at the end of the previous line (K&amp;R style)."/>
            <message key="line.previous" value="Put ''{0}'' at the end of the previous line (K&amp;R style)."/>
            <message key="line.break.after" value="Start a new line after ''{0}'' (K&amp;R style)."/>
        </module>
        <module name="RightCurly">
            <property name="id" value="kr-braces"/>
            <message key="line.same" value="Put ''{0}'' on the same line as the following else, catch or finally."/>
        </module>

        <!-- Section 6. Blank Lines: declare variables as close to their first use as possible. -->
        <module name="VariableDeclarationUsageDistance">
            <property name="id" value="declare-near-use"/>
            <property name="allowedDistance" value="3"/>
            <property name="ignoreFinal" value="true"/>
        </module>

        <!-- Section 7. Blank Space: binary operators are separated from their operands by spaces. -->
        <module name="WhitespaceAround">
            <property name="id" value="spaces-around-operators"/>
            <property name="tokens"
                      value="ASSIGN, BAND, BAND_ASSIGN, BOR, BOR_ASSIGN, BSR, BSR_ASSIGN, BXOR, BXOR_ASSIGN,
                             COLON, DIV, DIV_ASSIGN, EQUAL, GE, GT, LAMBDA, LAND, LE, LOR, LT, MINUS,
                             MINUS_ASSIGN, MOD, MOD_ASSIGN, NOT_EQUAL, PLUS, PLUS_ASSIGN, QUESTION, SL,
                             SL_ASSIGN, SR, SR_ASSIGN, STAR, STAR_ASSIGN"/>
            <message key="ws.notFollowed" value="Put a space after ''{0}''."/>
            <message key="ws.notPreceded" value="Put a space before ''{0}''."/>
        </module>

        <!-- Section 7. Blank Space: no space between a unary operator and its operand. -->
        <module name="NoWhitespaceAfter">
            <property name="id" value="unary-operators"/>
            <property name="tokens" value="BNOT, DEC, INC, LNOT, UNARY_MINUS, UNARY_PLUS"/>
            <message key="ws.followed" value="Remove the space after the unary operator ''{0}''."/>
        </module>
        <module name="NoWhitespaceBefore">
            <property name="id" value="unary-operators"/>
            <property name="tokens" value="POST_DEC, POST_INC"/>
            <message key="ws.preceded" value="Remove the space before ''{0}''."/>
        </module>

        <!-- Section 8. for loops: no conditionals for the first/last iteration (heuristic). -->
        <module name="grading.style.checks.LoopEdgeConditionalCheck">
            <property name="id" value="loop-edge-conditional"/>
        </module>

        <!-- Sections 9 and 10: a space between if/else/for/while and the parentheses, and before '{'. -->
        <module name="WhitespaceAround">
            <property name="id" value="statement-form"/>
            <property name="tokens"
                      value="LCURLY, RCURLY, LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE,
                             LITERAL_DO, LITERAL_TRY, LITERAL_CATCH, LITERAL_FINALLY, LITERAL_RETURN,
                             LITERAL_SWITCH, LITERAL_SYNCHRONIZED"/>
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <message key="ws.notFollowed" value="Put a space after ''{0}''."/>
            <message key="ws.notPreceded" value="Put a space before ''{0}''."/>
        </module>
        <module name="WhitespaceAfter">
            <property name="id" value="statement-form"/>
            <property name="tokens" value="COMMA, SEMI"/>
            <message key="ws.notFollowed" value="Put a space after ''{0}''."/>
        </module>

        <!-- Section 9. if/else: do not check boolean values for equality (== true, == false). -->
        <module name="SimplifyBooleanExpression">
            <property name="id" value="no-boolean-equality"/>
            <message key="simplify.expression"
                     value="Do not compare a boolean with true or false; use the value directly."/>
        </module>

        <!-- Section 9. if/else: rewrite branching logic that has an empty branch. -->
        <module name="EmptyBlock">
            <property name="id" value="empty-branch"/>
            <property name="option" value="statement"/>
            <property name="tokens" value="LITERAL_IF, LITERAL_ELSE, LITERAL_WHILE, LITERAL_FOR, LITERAL_DO"/>
            <message key="block.noStatement" value="Empty block; rewrite the logic without the empty branch."/>
        </module>

        <!-- Section 9. if/else: avoid nesting if statements that can be written as one. -->
        <module name="NestedIfDepth">
            <property name="id" value="nested-if-depth"/>
            <property name="max" value="1"/>
            <message key="nested.if.depth"
                     value="if statements are nested {0,number,integer} deep (limit {1,number,integer}); combine them with else-if or &amp;&amp;."/>
        </module>

        <!-- Section 10. for loops: avoid break and continue in an infinite loop. -->
        <module name="grading.style.checks.InfiniteLoopExitCheck">
            <property name="id" value="infinite-loop-exit"/>
        </module>

        <!-- Section 11. Returning values: return the boolean expression directly. -->
        <module name="SimplifyBooleanReturn">
            <property name="id" value="simplified-boolean-return"/>
            <message key="simplify.boolReturn"
                     value="Return the boolean expression directly instead of returning true or false in an if."/>
        </module>
    </module>
</module>
