<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.MainViewController"
      spacing="14" styleClass="workspace">
    <HBox alignment="CENTER_LEFT" spacing="24">
        <VBox spacing="6">
            <Label text="AGS" styleClass="title"/>
            <Label text="Auto Grading System"
                   styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="helpButton" text="How to grade" onAction="#showHelp" minWidth="-Infinity"
                styleClass="score-sheet-button" accessibleText="Show how to grade a batch of submissions"/>
        <HBox alignment="CENTER" spacing="8" maxHeight="34" styleClass="status-badge">
            <Circle radius="3.5" styleClass="status-dot"/>
            <Label fx:id="statusText" text="Not started" styleClass="status-text"/>
        </HBox>
    </HBox>

    <HBox spacing="20" minHeight="170" prefHeight="270">
        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" styleClass="file-panel">
            <VBox spacing="12" styleClass="panel-heading">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4">
                        <Label text="Tester files" styleClass="panel-title"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="testerImportButton" text="Import folder" minWidth="120"
                            styleClass="import-button"
                            onAction="#importTesterFiles"/>
                </HBox>
                <Label text="Select the Tester-Files folder."
                       styleClass="muted" wrapText="true"/>
                <TextField fx:id="testerFolderField" promptText="No tester folder selected"
                           editable="false" focusTraversable="false"
                           accessibleText="Tester files folder"/>
            </VBox>
            <StackPane minHeight="90" VBox.vgrow="ALWAYS" styleClass="browser-body">
                <TreeView fx:id="testerFiles" editable="false" focusTraversable="false"
                          accessibleText="Imported tester folders and files" styleClass="file-tree"/>
                <VBox fx:id="testerEmptyState" alignment="CENTER" spacing="10"
                      mouseTransparent="true" styleClass="empty-state">
                    <StackPane minWidth="48" maxWidth="48" minHeight="44" maxHeight="44" styleClass="empty-icon">
                        <SVGPath content="M 3 7 H 12 L 15 10 H 29 V 25 H 3 Z M 3 10 H 29" styleClass="folder-icon"/>
                    </StackPane>
                    <Label text="No tester files imported" styleClass="empty-title"/>
                    <Label text="Your tester folder and its files will appear here."
                           wrapText="true" maxWidth="310" styleClass="empty-description"/>
                </VBox>
            </StackPane>
        </VBox>

        <VBox minWidth="0" prefWidth="0" HBox.hgrow="ALWAYS" styleClass="file-panel">
            <VBox spacing="12" styleClass="panel-heading">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4">
                        <Label text="Student submissions" styleClass="panel-title"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="submissionImportButton" text="Import folder" minWidth="120"
                            styleClass="import-button"
                            onAction="#importSubmissions"/>
                </HBox>
                <Label text="Select the submission folder."
                       styleClass="muted" wrapText="true"/>
                <TextField fx:id="submissionFolderField" promptText="No submissions folder selected"
                           editable="false" focusTraversable="false"
                           accessibleText="Student submissions folder"/>
            </VBox>
            <StackPane minHeight="90" VBox.vgrow="ALWAYS" styleClass="browser-body">
                <TreeView fx:id="submissionFiles" editable="false" focusTraversable="false"
                          accessibleText="Imported student folders and submission files" styleClass="file-tree"/>
                <VBox fx:id="submissionEmptyState" alignment="CENTER" spacing="10"
                      mouseTransparent="true" styleClass="empty-state">
                    <StackPane minWidth="48" maxWidth="48" minHeight="44" maxHeight="44" styleClass="empty-icon">
                        <SVGPath content="M 4 7 H 13 L 16 10 H 29 V 26 H 4 Z M 4 10 H 29 M 1 4 H 10 L 13 7"
                                 styleClass="folder-icon"/>
                    </StackPane>
                    <Label text="No student submissions imported" styleClass="empty-title"/>
                    <Label text="Student folders and their submitted files will appear here."
                           wrapText="true" maxWidth="310" styleClass="empty-description"/>
                </VBox>
            </StackPane>
        </VBox>
    </HBox>

    <HBox spacing="20" alignment="CENTER_LEFT" styleClass="run-toolbar">
        <VBox spacing="4">
            <Label text="Prepare a grading run" styleClass="section-title"/>
            <Label fx:id="runReadinessText" text="Import both folders to get started." styleClass="muted"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox fx:id="progressBox" spacing="4" alignment="CENTER_LEFT" visible="false" managed="false">
            <ProgressBar fx:id="gradingProgress" prefWidth="240" progress="0"/>
            <Label fx:id="progressText" styleClass="muted"/>
        </VBox>
        <Button fx:id="cancelButton" text="Cancel" visible="false" managed="false"
                styleClass="score-sheet-button" onAction="#cancelGrading"
                accessibleText="Stop the grading run; marks from before it are kept"/>
        <Button fx:id="regradeButton" text="Regrade selected" disable="true"
                styleClass="score-sheet-button" onAction="#regradeSelected"
                accessibleText="Grade the student selected in the results table again"/>
        <Button fx:id="runGradingButton" text="Run grading" onAction="#runGrading"
                disable="true" minWidth="166" graphicTextGap="10" styleClass="run-button">
            <graphic>
                <SVGPath content="M 0 0 L 0 12 L 9 6 Z" styleClass="play-icon"/>
            </graphic>
        </Button>
    </HBox>

    <VBox minHeight="220" prefHeight="420" VBox.vgrow="ALWAYS" styleClass="console-panel">
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="console-heading">
            <VBox spacing="4" minWidth="-Infinity">
                <Label text="Results &amp; reports" styleClass="console-title"/>
                <Label text="Scores, similar answers, feedback and the grading log" styleClass="console-description"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="scoreSheetImportButton" minWidth="-Infinity" text="Import score sheet"
                    styleClass="score-sheet-button" onAction="#importScoreSheet"
                    accessibleText="Import the score sheet CSV to fill with totals"/>
            <Button fx:id="writeScoresButton" minWidth="-Infinity" text="Save filled sheet" disable="true"
                    styleClass="score-sheet-button" onAction="#writeScoresToSheet"
                    accessibleText="Save a copy of the imported score sheet with each student's total filled in"/>
            <Button fx:id="saveReportsButton" minWidth="-Infinity" text="Save reports" disable="true"
                    styleClass="score-sheet-button" onAction="#saveReports"
                    accessibleText="Save the latest grading attempt's PDF reports as a ZIP file"/>
            <Button fx:id="resolveIssuesButton" minWidth="-Infinity" text="Resolve issues" visible="false" managed="false"
                    styleClass="resolution-button" onAction="#resolveSubmissionIssues"/>
            <Label fx:id="consoleStatus" text="Waiting for an import" styleClass="console-description"
                   minWidth="0" maxWidth="320" textOverrun="ELLIPSIS"/>
        </HBox>
        <SplitPane fx:id="resultsSplit" orientation="VERTICAL" dividerPositions="0.55" VBox.vgrow="ALWAYS"
                   styleClass="results-split">
            <SplitPane dividerPositions="0.62">
                <StackPane fx:id="resultsHolder" minHeight="90"/>
                <StackPane fx:id="detailHolder" minWidth="220"/>
            </SplitPane>
            <TabPane fx:id="consoleTabs" tabClosingPolicy="UNAVAILABLE" minHeight="90">
                <Tab text="Activity">
                    <TextArea fx:id="findingsConsole"
                              promptText="Validation findings and the grading log will appear here."
                              editable="false" wrapText="true" focusTraversable="false"
                              accessibleText="Grading console: findings and reports" styleClass="console"/>
                </Tab>
                <Tab fx:id="similarityTab" text="Similar answers">
                    <StackPane fx:id="similarityHolder"/>
                </Tab>
            </TabPane>
        </SplitPane>
    </VBox>
</VBox>
