@startuml
' 7. Scoring, reports and the LMS score sheet
' Each member starts with <U+00A0> (an invisible space) so that every renderer, draw.io included,
' prints the visibility markers + - # ~ as text instead of icons.
top to bottom direction
set separator none
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam titleFontSize 20
skinparam nodesep 25
skinparam ranksep 35
skinparam padding 2
skinparam ArrowColor #3A3A3A
skinparam ArrowThickness 1.2
skinparam classBorderColor #2E686A
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #E3EEEE
skinparam packageBorderColor #7FA3A4
skinparam packageBackgroundColor #FAFCFC
skinparam packageFontColor #2E686A
skinparam class {
  BackgroundColor<<external>> #F2F2F2
  BorderColor<<external>> #A0A0A0
  FontColor<<external>> #555555
}
hide empty members
hide <<external>> members
hide <<external>> stereotype
hide <<external>> circle

title 7. Scoring, reports and the LMS score sheet

package "grading.reporting" {
  class GradingAttempt <<record>> {
    <U+00A0>- startedAt : LocalDateTime
    <U+00A0>- testerFolder : Path
    <U+00A0>- submissionsFolder : Path
    <U+00A0>- settings : GradingSettings
    <U+00A0>- students : List<StudentOutcome>
    <U+00A0>- similarity : SimilarityReport
    {static} <U+00A0>+ assemble(startedAt : LocalDateTime, testerFolder : Path, submissionsFolder : Path, settings : GradingSettings, submissions : List<SubmissionValidationResult>, results : List<StudentGradingResult>, styleChecker : StyleChecker) : GradingAttempt
    <U+00A0>+ scores() : List<ScoreBreakdown>
  }

  class StudentOutcome <<record>> {
    <U+00A0>- submission : SubmissionValidationResult
    <U+00A0>- grading : StudentGradingResult
    <U+00A0>- style : StudentStyleResult
    <U+00A0>- score : ScoreBreakdown
    <U+00A0>- feedback : List<Feedback>
    <U+00A0>+ reviewReasons() : List<String>
  }

  class AttemptReportWriter {
    <U+00A0>- reportsRoot : Path
    <U+00A0>+ AttemptReportWriter(reportsRoot : Path)
    <U+00A0>+ write(attempt : GradingAttempt) : Written
    {static} <U+00A0>+ studentReportOf(attemptFolder : Path, username : String) : Optional<Path>
  }

  class AttemptSummaryFormatter {
    {static} <U+00A0>+ format(attempt : GradingAttempt, attemptId : String, reportFiles : Map<StudentOutcome, String>, problems : List<String>) : String
  }

  class StudentReportFormatter {
    {static} <U+00A0>+ format(student : StudentOutcome, attempt : GradingAttempt, attemptId : String) : String
  }

  class ScoresCsv {
    {static} <U+00A0>~~ format(scores : List<ScoreBreakdown>) : String
  }

  class PdfReportRenderer {
    <U+00A0>~~ render(markdown : String, pdf : Path, footer : String) : void
  }

  class ReportArchive {
    {static} <U+00A0>+ save(attemptFolder : Path, zipFile : Path) : void
  }

  class ScoreSheet {
    <U+00A0>- path : Path
    <U+00A0>- usernameColumn : int
    <U+00A0>- numeratorColumn : int
    {static} <U+00A0>+ load(path : Path) : ScoreSheet
    <U+00A0>+ rowCount() : int
    <U+00A0>+ username(row : int) : String
  }

  class ScoreSheetUpdater {
    <U+00A0>+ preview(sheet : ScoreSheet, scores : ScoreSummary) : ScoreSheetPreview
    <U+00A0>+ filledContent(preview : ScoreSheetPreview) : byte[]
  }

  class ScoreSheetPreview <<record>> {
    <U+00A0>- sheet : ScoreSheet
    <U+00A0>- entries : List<Entry>
    <U+00A0>- notInSheet : List<String>
    <U+00A0>- noSubmission : List<String>
  }

  class ScoreSheetException {
    <U+00A0>+ ScoreSheetException(message : String)
  }
}

package "grading.scoring" {
  class ScoreBreakdown <<record>> {
    <U+00A0>- username : String
    <U+00A0>- questionScores : Map<String, Double>
    <U+00A0>- testerMarks : double
    <U+00A0>- stylePenalty : double
    <U+00A0>- finalMark : double
    {static} <U+00A0>+ of(result : StudentGradingResult, style : StudentStyleResult, penalties : PenaltySettings) : ScoreBreakdown
    <U+00A0>+ toStudentScore() : StudentScore
  }

  class StudentScore <<record>> {
    <U+00A0>- username : String
    <U+00A0>- questionScores : Map<String, Double>
    <U+00A0>- total : double
    {static} <U+00A0>+ from(result : StudentGradingResult) : StudentScore
  }

  class ScoreSummary <<record>> {
    <U+00A0>- students : List<StudentScore>
    <U+00A0>+ find(username : String) : Optional<StudentScore>
  }
}

class IOException <<external>>

GradingAttempt --> "*" StudentOutcome
StudentOutcome --> "1" ScoreBreakdown
AttemptReportWriter ..> GradingAttempt
AttemptReportWriter ..> AttemptSummaryFormatter
AttemptReportWriter ..> StudentReportFormatter
AttemptReportWriter ..> ScoresCsv
AttemptReportWriter ..> PdfReportRenderer
ReportArchive -[hidden]down- ScoreSheet

ScoreBreakdown ..> StudentScore : creates
ScoreSummary --> "*" StudentScore
ScoreSheetUpdater ..> ScoreSummary
ScoreSheetUpdater ..> ScoreSheetPreview : creates
ScoreSheetPreview --> "1" ScoreSheet
ScoreSheet ..> ScoreSheetException : throws
IOException <|-- ScoreSheetException
@enduml
