@startuml
' 1. Architecture overview: packages and layers
' Each member starts with <U+00A0> (an invisible space) so that every renderer, draw.io included,
' prints the visibility markers + - # ~ as text instead of icons.
top to bottom direction
set separator none
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam titleFontSize 20
skinparam nodesep 25
skinparam ranksep 35
skinparam padding 2
skinparam ArrowColor #3A3A3A
skinparam ArrowThickness 1.2
skinparam classBorderColor #2E686A
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #E3EEEE
skinparam packageBorderColor #7FA3A4
skinparam packageBackgroundColor #FAFCFC
skinparam packageFontColor #2E686A
skinparam class {
  BackgroundColor<<external>> #F2F2F2
  BorderColor<<external>> #A0A0A0
  FontColor<<external>> #555555
}
hide empty members
hide <<external>> members
hide <<external>> stereotype
hide <<external>> circle

title 1. Architecture overview: packages and layers

hide members

package "ui (view + controller)" as ui {
  class AutoGradingApplication
  class MainViewController
  AutoGradingApplication -[hidden]down- MainViewController
}

package "grading.session" as session {
  class GradingSession
  class WorkFolders
  GradingSession -[hidden]down- WorkFolders
}

package "grading.progress" as progress {
  class ProgressTracker
  class ProgressSnapshot
  ProgressTracker -[hidden]down- ProgressSnapshot
}

package "grading.submission" as submission {
  class SubmissionPreparationService
  interface SubmissionCheck
  abstract class SubmissionSource
  SubmissionPreparationService -[hidden]down- SubmissionCheck
  SubmissionCheck -[hidden]down- SubmissionSource
}

package "grading.tester" as tester {
  class TesterFileValidationService
  class TesterValidationResult
  TesterFileValidationService -[hidden]down- TesterValidationResult
}

package "grading.execution" as execution {
  class JavaGradingService
  class TimeoutRecovery
  interface ProcessRunner
  JavaGradingService -[hidden]down- TimeoutRecovery
  TimeoutRecovery -[hidden]down- ProcessRunner
}

package "grading.reporting" as reporting {
  class GradingAttempt
  class AttemptReportWriter
  class ScoreSheetUpdater
  GradingAttempt -[hidden]down- AttemptReportWriter
  AttemptReportWriter -[hidden]down- ScoreSheetUpdater
}

package "grading.style" as style {
  class StyleChecker
}

package "grading.similarity" as similarity {
  class SimilarityChecker
}

package "grading.feedback" as feedback {
  class FeedbackGenerator
}

package "grading.scoring" as scoring {
  class ScoreBreakdown
}

package "grading.config + grading.assessment" as config {
  class GradingSettings
  class AssessmentDefinition
  GradingSettings -[hidden]right- AssessmentDefinition
}

ui ..> session
ui ..> progress
session ..> submission
session ..> tester
session ..> execution
session ..> reporting
execution ..> progress
reporting ..> style
reporting ..> similarity
reporting ..> feedback
reporting ..> scoring
scoring -[hidden]down- config
similarity -[hidden]down- config

note bottom of AssessmentDefinition
  Every package reads its settings from here.
  Values live in grading.properties and
  assessment.properties, never in the code.
end note
@enduml
