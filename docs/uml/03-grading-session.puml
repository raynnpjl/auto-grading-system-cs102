@startuml
' 3. Grading engine: session, run control and live progress
' Each member starts with <U+00A0> (an invisible space) so that every renderer, draw.io included,
' prints the visibility markers + - # ~ as text instead of icons.
top to bottom direction
set separator none
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam titleFontSize 20
skinparam nodesep 25
skinparam ranksep 35
skinparam padding 2
skinparam ArrowColor #3A3A3A
skinparam ArrowThickness 1.2
skinparam classBorderColor #2E686A
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #E3EEEE
skinparam packageBorderColor #7FA3A4
skinparam packageBackgroundColor #FAFCFC
skinparam packageFontColor #2E686A
skinparam class {
  BackgroundColor<<external>> #F2F2F2
  BorderColor<<external>> #A0A0A0
  FontColor<<external>> #555555
}
hide empty members
hide <<external>> members
hide <<external>> stereotype
hide <<external>> circle

title 3. Grading engine: session, run control and live progress

package "grading.session" {
  class GradingSession {
    <U+00A0>- settings : GradingSettings
    <U+00A0>- progress : ProgressTracker
    <U+00A0>- testerService : TesterFileValidationService
    <U+00A0>- submissionService : SubmissionPreparationService
    <U+00A0>- correctionService : SubmissionCorrectionService
    <U+00A0>- testers : TesterValidationResult
    <U+00A0>- submissions : List<SubmissionValidationResult>
    <U+00A0>- latestAttempt : GradingAttempt
    <U+00A0>- lastOutcome : RunOutcome
    <U+00A0>+ GradingSession(settings : GradingSettings, progress : ProgressTracker, workFolder : Path)
    <U+00A0>+ importTesters(folder : Path) : TesterValidationResult
    <U+00A0>+ importSubmissions(input : Path, listener : ImportProgress) : List<SubmissionValidationResult>
    <U+00A0>+ confirmIdentity(target : String, identity : StudentIdentity) : void
    <U+00A0>+ startGrading() : void
    <U+00A0>+ regrade(username : String) : void
    <U+00A0>+ cancelGrading() : void
    <U+00A0>+ currentScores() : ScoreSummary
    <U+00A0>+ reportsFolder() : Optional<Path>
  }

  enum RunOutcome {
    NONE
    COMPLETED
    CANCELLED
    FAILED
  }

  class SessionRefusal {
    <U+00A0>- reason : Reason
    <U+00A0>+ SessionRefusal(reason : Reason, message : String)
    <U+00A0>+ reason() : Reason
  }

  enum "SessionRefusal.Reason" as Reason {
    INVALID
    NOT_FOUND
    BUSY
  }

  class WorkFolders {
    {static} <U+00A0>+ create(temporaryRoot : Path) : Path
    {static} <U+00A0>+ removeAbandoned(temporaryRoot : Path, now : Instant) : int
    {static} <U+00A0>+ deleteWhenStopped(running : GradingSession, folder : Path) : void
  }
}

package "grading.progress" {
  class ProgressTracker {
    <U+00A0>- rows : Map<String, Row>
    <U+00A0>- activity : List<String>
    <U+00A0>- similarPairs : List<SimilarityPair>
    <U+00A0>+ prepare(submissions : List<SubmissionValidationResult>) : void
    <U+00A0>+ studentStarted(username : String) : void
    <U+00A0>+ questionFinished(username : String, questionId : String, score : double, status : QuestionGradingResult.Status) : void
    <U+00A0>+ studentFinished(username : String, hasErrors : boolean) : void
    <U+00A0>+ similarity(pairs : List<SimilarityPair>) : void
    <U+00A0>+ snapshot() : ProgressSnapshot
  }

  class ProgressSnapshot <<record>> {
    <U+00A0>- done : long
    <U+00A0>- students : List<StudentProgress>
    <U+00A0>- activity : List<String>
    <U+00A0>- similarPairs : List<SimilarityPair>
    <U+00A0>+ total() : int
  }

  class StudentProgress <<record>> {
    <U+00A0>- username : String
    <U+00A0>- status : GradingStatus
    <U+00A0>- scores : Map<String, Double>
    <U+00A0>- issues : List<String>
    <U+00A0>- corrections : List<String>
    <U+00A0>- flags : List<SimilarAnswer>
    <U+00A0>+ formatFixed() : boolean
    <U+00A0>+ total() : double
  }

  enum GradingStatus {
    QUEUED
    RUNNING
    GRADED
    NEEDS_REVIEW
    SKIPPED
    <U+00A0>+ label() : String
    <U+00A0>+ needsAttention() : boolean
  }

  class SimilarAnswer <<record>> {
    <U+00A0>- questionId : String
    <U+00A0>- percent : long
    <U+00A0>- otherStudent : String
    <U+00A0>+ describe() : String
  }
}

class RuntimeException <<external>>
class SubmissionPreparationService <<external>>
class SubmissionCorrectionService <<external>>
class TesterFileValidationService <<external>>
class JavaGradingService <<external>>
class GradingAttempt <<external>>
class AttemptReportWriter <<external>>

GradingSession --> "1" ProgressTracker
GradingSession --> "1" SubmissionPreparationService
GradingSession --> "1" SubmissionCorrectionService
GradingSession --> "1" TesterFileValidationService
GradingSession --> "1" RunOutcome
GradingSession ..> JavaGradingService : runs a batch
GradingSession ..> GradingAttempt : assembles
GradingSession ..> AttemptReportWriter : writes reports
GradingSession ..> SessionRefusal : throws
WorkFolders ..> GradingSession
RuntimeException <|-- SessionRefusal
SessionRefusal +-- Reason

JavaGradingService --> "1" ProgressTracker : reports progress
ProgressTracker ..> ProgressSnapshot : creates
ProgressSnapshot --> "*" StudentProgress
StudentProgress --> "1" GradingStatus
StudentProgress --> "*" SimilarAnswer
@enduml
