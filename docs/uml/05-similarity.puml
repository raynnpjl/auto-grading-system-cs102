@startuml
' 5. Plagiarism detection: two interchangeable similarity algorithms
' Each member starts with <U+00A0> (an invisible space) so that every renderer, draw.io included,
' prints the visibility markers + - # ~ as text instead of icons.
top to bottom direction
set separator none
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam titleFontSize 20
skinparam nodesep 25
skinparam ranksep 35
skinparam padding 2
skinparam ArrowColor #3A3A3A
skinparam ArrowThickness 1.2
skinparam classBorderColor #2E686A
skinparam classBackgroundColor #FFFFFF
skinparam classHeaderBackgroundColor #E3EEEE
skinparam packageBorderColor #7FA3A4
skinparam packageBackgroundColor #FAFCFC
skinparam packageFontColor #2E686A
skinparam class {
  BackgroundColor<<external>> #F2F2F2
  BorderColor<<external>> #A0A0A0
  FontColor<<external>> #555555
}
hide empty members
hide <<external>> members
hide <<external>> stereotype
hide <<external>> circle

title 5. Plagiarism detection: two interchangeable similarity algorithms

package "grading.similarity" {
  class SimilarityChecker {
    <U+00A0>- settings : SimilaritySettings
    <U+00A0>- templates : Templates
    <U+00A0>- screening : SimilarityAlgorithm
    <U+00A0>- scoring : SimilarityAlgorithm
    <U+00A0>+ SimilarityChecker(settings : SimilaritySettings, templates : Templates)
    <U+00A0>+ check(submissions : List<SubmissionValidationResult>) : SimilarityReport
  }

  interface SimilarityAlgorithm {
    <U+00A0>+ name() : String
    <U+00A0>+ compare(first : List<Token>, second : List<Token>) : Comparison
  }

  class WinnowingSimilarity {
    <U+00A0>- kgramSize : int
    <U+00A0>- windowSize : int
    <U+00A0>+ name() : String
    <U+00A0>+ compare(first : List<Token>, second : List<Token>) : Comparison
    <U+00A0>~~ fingerprints(tokens : List<Token>) : Map<Integer, Integer>
  }

  class GreedyStringTiling {
    <U+00A0>- minMatchLength : int
    <U+00A0>+ name() : String
    <U+00A0>+ compare(first : List<Token>, second : List<Token>) : Comparison
  }

  class JavaTokenizer {
    {static} <U+00A0>~~ tokenize(file : String, lines : List<String>, skippedLines : Set<Integer>) : List<Token>
  }

  class Token <<record>> {
    <U+00A0>- kind : String
    <U+00A0>- file : String
    <U+00A0>- line : int
  }

  class Comparison <<record>> {
    <U+00A0>- score : double
    <U+00A0>- matches : List<Match>
    {static} <U+00A0>~~ none() : Comparison
  }

  class SimilarityReport <<record>> {
    <U+00A0>- pairs : List<SimilarityPair>
    <U+00A0>- settings : SimilaritySettings
    <U+00A0>- algorithms : List<String>
    <U+00A0>- compared : int
    <U+00A0>+ flaggedFor(username : String) : List<SimilarityPair>
  }

  class SimilarityPair <<record>> {
    <U+00A0>- questionId : String
    <U+00A0>- first : String
    <U+00A0>- second : String
    <U+00A0>- winnowing : double
    <U+00A0>- tiling : double
    <U+00A0>- flagged : boolean
    <U+00A0>+ percent() : long
    <U+00A0>+ involves(username : String) : boolean
  }
}

class SimilaritySettings <<external>>
class Templates <<external>>

SimilarityChecker --> "1" SimilarityAlgorithm : screening
SimilarityChecker --> "1" SimilarityAlgorithm : scoring
SimilarityAlgorithm <|.. WinnowingSimilarity
SimilarityAlgorithm <|.. GreedyStringTiling
SimilarityChecker ..> JavaTokenizer
JavaTokenizer ..> Token : creates
SimilarityAlgorithm ..> Token
SimilarityAlgorithm ..> Comparison : returns
SimilarityChecker ..> SimilarityReport : creates
SimilarityReport --> "*" SimilarityPair
SimilarityChecker --> "1" SimilaritySettings
SimilarityChecker --> "1" Templates : ignores template code
@enduml
